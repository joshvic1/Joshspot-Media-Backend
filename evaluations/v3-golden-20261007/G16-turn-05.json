      "direction": "inbound",
      "type": "text",
      "status": "received",
      "text": "I have 5k per day",
      "createdAt": "2026-10-07T09:19:42.211Z"
    },
    {
      "_id": "G16-out-1",
      "direction": "outbound",
      "type": "text",
      "status": "sent",
      "text": "Thanks for sharing your daily budget of 5,000 for Meta ads management.\n\nCould you also tell me how many days you want your Meta ads campaign to run? This will help me prepare an accurate quote for you.",
      "createdAt": "2026-10-07T09:19:47.027Z"
    },
    {
      "_id": "G16-in-2",
      "direction": "inbound",
      "type": "text",
      "status": "received",
      "text": "how long do you recommend",
      "createdAt": "2026-10-07T09:19:47.030Z"
    },
    {
      "_id": "G16-out-2",
      "direction": "outbound",
      "type": "text",
      "status": "sent",
      "text": "For Meta ads management with a daily budget of 5,000, a common recommended campaign duration is around 14 to 30 days. This allows enough time for the ads to optimize and gather meaningful results.\n\nWould you prefer a shorter 2-week campaign to test performance or a month-long campaign for more sustained exposure? Or do you have a specific duration in mind?",
      "createdAt": "2026-10-07T09:19:51.828Z"
